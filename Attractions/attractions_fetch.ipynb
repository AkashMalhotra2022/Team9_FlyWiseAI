]

# Cell 5: Places API Implementation
class PlacesAPIFetcher:
    def __init__(self, api_key):
        self.api_key = api_key
        self.base_url = "https://places.googleapis.com/v1/places"

    def search_nearby(self, location, radius=20000, place_type=None):
        """Search for places using new API"""
        url = f"{self.base_url}:searchNearby"

        headers = {
            'Content-Type': 'application/json',
            'X-Goog-Api-Key': self.api_key,
            'X-Goog-FieldMask': 'places.id,places.displayName,places.formattedAddress,places.location,places.rating,places.userRatingCount,places.priceLevel,places.websiteUri,places.editorialSummary,places.types,places.primaryTypeDisplayName'
        }

        body = {
            "includedTypes": [place_type] if place_type else [],
            "maxResultCount": 20,
            "locationRestriction": {
                "circle": {
                    "center": {
                        "latitude": location['lat'],
                        "longitude": location['lng']
                    },
                    "radius": radius
                }
            }
        }

        try:
            response = requests.post(url, headers=headers, json=body)
            if response.status_code == 200:
                return response.json().get('places', [])
            else:
                print(f"API Error: {response.status_code} - {response.text}")
                return []
        except Exception as e:
            print(f"Request failed: {e}")
            return []

    def get_place_reviews(self, place_id):
        """Get reviews for a place"""
        url = f"{self.base_url}/{place_id}"

        headers = {
            'X-Goog-Api-Key': self.api_key,
            'X-Goog-FieldMask': 'reviews'
        }

        try:
            response = requests.get(url, headers=headers)
            if response.status_code == 200:
                return response.json().get('reviews', [])
            else:
                return []
        except:
            return []

# Cell 6: Helper Functions
def extract_price_level(price_level):
    """Convert price level to readable format"""
    price_map = {
        'PRICE_LEVEL_FREE': 'Free',
        'PRICE_LEVEL_INEXPENSIVE': '$',
        'PRICE_LEVEL_MODERATE': '$$',
        'PRICE_LEVEL_EXPENSIVE': '$$$',
        'PRICE_LEVEL_VERY_EXPENSIVE': '$$$$'
    }
    return price_map.get(price_level, 'Not Available')

def format_reviews(reviews):
    """Format reviews for display"""
    if not reviews:
        return ""

    review_texts = []
    for review in reviews[:3]:  # Get top 3 reviews
        if 'text' in review and 'text' in review['text']:
            review_texts.append(review['text']['text'])

    return " | ".join(review_texts) if review_texts else ""

# Cell 7: Main Data Collection Function
def collect_attractions_data():
    """Main function to collect all attractions data"""

    print("🚀 Starting Attractions Data Collection")
    print("=" * 60)

    fetcher = PlacesAPIFetcher(GOOGLE_API_KEY)
    all_attractions = []

    for city in CITIES:
        print(f"\n🏙️ Processing {city['name']}...")

        for category_name, place_type in ATTRACTION_CATEGORIES.items():
            print(f"  📍 Searching for {category_name}...")

            # Search for places
            places = fetcher.search_nearby(
                location={'lat': city['lat'], 'lng': city['lng']},
                place_type=place_type
            )

            for place in tqdm(places[:10], desc=f"    Processing"):
                try:
                    # Extract basic info
                    place_id = place.get('id', '')

                    # Get reviews separately if needed
                    reviews = fetcher.get_place_reviews(place_id)

                    # Extract location
                    location = place.get('location', {})
                    lat = location.get('latitude', 0)
                    lng = location.get('longitude', 0)

                    # Get description from types and primary type
                    description = place.get('primaryTypeDisplayName', {}).get('text', '')
                    if not description:
                        types_list = place.get('types', [])
                        description = ', '.join(types_list[:3]) if types_list else 'Tourist Attraction'

                    # Build record with EXACTLY the columns you requested
                    attraction = {
                        'ID': f"{city['name'].replace(' ', '_')}_{place_id[:10]}",
                        'Name': place.get('displayName', {}).get('text', '') if 'displayName' in place else '',
                        'Type of Attraction': category_name,
                        'Formatted address': place.get('formattedAddress', ''),
                        'Location': city['name'],
                        'Lat': lat,
                        'Long': lng,
                        'Rating': place.get('rating', 0),
                        'Description': description,
                        'Prices': extract_price_level(place.get('priceLevel', '')),
                        'Reviews': format_reviews(reviews),
                        'Editorial Summary': place.get('editorialSummary', {}).get('text', '') if 'editorialSummary' in place else ''
                    }

                    all_attractions.append(attraction)
                    time.sleep(0.1)  # Rate limiting

                except Exception as e:
                    print(f"    ❌ Error processing place: {e}")
                    continue

        print(f"  ✅ Found {len([a for a in all_attractions if a['Location'] == city['name']])} attractions")

    # Create DataFrame with EXACTLY your columns
    df = pd.DataFrame(all_attractions)

    # Ensure column order matches your specification
    column_order = [
        'ID',
        'Name',
        'Type of Attraction',
        'Formatted address',
        'Location',
        'Lat',
        'Long',
        'Rating',
        'Description',
        'Prices',
        'Reviews',
        'Editorial Summary'
    ]

    # Reorder columns
    df = df[column_order]

    # Save to CSV
    if len(df) > 0:
        timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
        filename = f'attractions_bronze_layer_{timestamp}.csv'
        df.to_csv(filename, index=False)
        print(f"\n✅ Saved {len(df)} attractions to {filename}")

        # Display basic statistics
        print(f"\n📊 Data Collection Summary:")
        print(f"Total Attractions: {len(df)}")
        print(f"Cities: {', '.join(df['Location'].unique())}")
        print(f"Average Rating: {df['Rating'].mean():.2f}")
    else:
        print("\n⚠️ No data collected. Please check your API key and settings.")

    return df

# Cell 8: Execute and Display DataFrame
# Collect the data
df = collect_attractions_data()

